<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.danascape.launcher3feed.glance">

    <!-- Required to read and manage Glanceable Hub widgets through SystemUI's
         GlanceableHubWidgetManagerService. Signature level, so this app must be
         platform signed. -->
    <uses-permission android:name="com.android.systemui.permission.MANAGE_GLANCEABLE_HUB_WIDGETS" />

    <!-- The hub's widgets belong to other packages; we need to see them to render. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- To open the launcher's widget picker, the same one the hub uses. -->
    <uses-permission android:name="com.android.launcher3.permission.START_WIDGET_PICKER_ACTIVITY" />
    <uses-permission android:name="android.permission.START_WIDGET_PICKER_ACTIVITY" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_view"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".GlanceWidgetPickerActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false" />

        <service
            android:name=".GlanceOverlayService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="shortService">
            <intent-filter>
                <action android:name="com.android.launcher3.WINDOW_OVERLAY" />

                <data android:scheme="app" />
            </intent-filter>

            <meta-data
                android:name="service.api.version"
                android:value="7" />
        </service>
    </application>

</manifest>
